        "E-Mail_senden_bei_Erfolg": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "service@airco-systems.de;michael.doukas@mosaiic.com",
              "emailMessage/Subject": "[@{variables(\u0027VarKritikalitaet\u0027)}] Ticket - Firma: [@{variables(\u0027VarFirmenname\u0027)}]",
              "emailMessage/Body": "\u003Ctable id=\u0022table_0_0_0_0_0\u0022 style=\u0022box-sizing: border-box; border-collapse: collapse; border-spacing: 0px;\u0022\u003E\n  \u003Ctbody\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding-bottom: 4px; width: 115.125px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cdiv style=\u0022white-space: nowrap; font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E\u003Cb\u003EFirmenname\u003C/b\u003E\u003C/div\u003E\n      \u003C/td\u003E\n      \u003Ctd style=\u0022padding-top: 4px; padding-bottom: 4px; width: 198.427px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cspan style=\u0022font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E@{variables(\u0027VarFirmenname\u0027)}\u003C/span\u003E\n      \u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding-bottom: 4px; width: 115.125px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cdiv style=\u0022white-space: nowrap; font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E\u003Cb\u003EAnsprechpartner\u003C/b\u003E\u003C/div\u003E\n      \u003C/td\u003E\n      \u003Ctd style=\u0022padding-top: 4px; padding-bottom: 4px; width: 198.427px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cspan style=\u0022font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E@{variables(\u0027VarAnsprechpartner\u0027)}\u003C/span\u003E\n      \u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding-bottom: 4px; width: 115.125px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cdiv style=\u0022white-space: nowrap; font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E\u003Cb\u003ETelefonnummer\u003C/b\u003E\u003C/div\u003E\n      \u003C/td\u003E\n      \u003Ctd style=\u0022padding-top: 4px; padding-bottom: 4px; width: 198.427px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cspan style=\u0022font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E@{variables(\u0027VarTelefonnummer\u0027)}\u003C/span\u003E\n      \u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding-bottom: 4px; width: 115.125px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cdiv style=\u0022white-space: nowrap; font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E\u003Cb\u003EAnrufgrund\u003C/b\u003E\u003C/div\u003E\n      \u003C/td\u003E\n      \u003Ctd style=\u0022padding-top: 4px; padding-bottom: 4px; width: 198.427px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cspan style=\u0022font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E@{body(\u0027KI-Verarbeitung\u0027)?[\u0027structuredOutput/anrufgrund\u0027]}\u003C/span\u003E\n      \u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding-bottom: 4px; width: 115.125px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cdiv style=\u0022white-space: nowrap; font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E\u003Cb\u003EAnlage\u003C/b\u003E\u003C/div\u003E\n      \u003C/td\u003E\n      \u003Ctd style=\u0022padding-top: 4px; padding-bottom: 4px; width: 198.427px; height: 29.3333px; box-sizing: border-box;\u0022\u003E\n        \u003Cspan style=\u0022font-family: Calibri, sans-serif; font-size: 14px;\u0022\u003E@{triggerBody()?[\u0027text_5\u0027]}\u003C/span\u003E\n      \u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Ctd style=\u0022white-space: nowrap; padding-top: 4px; padding-right: 16px; padding