        "E-Mail_senden_bei_KI_fehlgeschlagen": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "service@airco-systems.de;michael.doukas@mosaiic.de",
              "emailMessage/Subject": "[UNBEKANNT - KI-Fehler] - Firma: @{triggerBody()?[\u0027text\u0027]}",
              "emailMessage/Body": "\u003Cp class=\u0022editor-paragraph\u0022\u003E\u0026lt;div\u0026gt;KI-Klassifizierung fehlgeschlagen - bitte manuell pr\u00FCfen.\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;\u0026lt;br\u0026gt;\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;Firmenname:\u0026amp;nbsp; @{triggerBody()?[\u0027text\u0027]}\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;Ansprechpartner:\u0026amp;nbsp; @{triggerBody()?[\u0027text_1\u0027]}\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;Telefon:\u0026amp;nbsp; @{triggerBody()?[\u0027text_2\u0027]}\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;Kanal:\u0026amp;nbsp; @{triggerBody()?[\u0027text_4\u0027]}\u003Cbr\u003E\u0026lt;/div\u0026gt;\u0026lt;div\u0026gt;Anrufgrund:\u0026amp;nbsp; @{triggerBody()?[\u0027text_6\u0027]}\u0026lt;/div\u0026gt;\u003C/p\u003E\u003Cbr\u003E",
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          },
          "runAfter": {
            "KI-Verarbeitung": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        },
